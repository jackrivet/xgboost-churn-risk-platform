ProcessingJobName: churn-risk-xgb-training-{{ ds_nodash }}

RoleArn: arn:aws:iam::<account-id>:role/<sagemaker-execution-role>

AppSpecification:
  ImageUri: <ecr-image-uri>

  ContainerEntrypoint:

python
/opt/ml/processing/code/train_xgb_processing.py


ProcessingInputs:


InputName: raw


    S3Input:
      S3Uri: s3://<bucket>/training/raw/
      LocalPath: /opt/ml/processing/input/raw
      S3DataType: S3Prefix
      S3InputMode: File
      S3DataDistributionType: FullyReplicated


InputName: code


    S3Input:
      S3Uri: s3://<bucket>/code/
      LocalPath: /opt/ml/processing/code
      S3DataType: S3Prefix
      S3InputMode: File
      S3DataDistributionType: FullyReplicated

ProcessingOutputConfig:

  Outputs:


OutputName: model_artifacts


      S3Output:
        S3Uri: s3://<bucket>/training/output/
        LocalPath: /opt/ml/processing/output
        S3UploadMode: EndOfJob

ProcessingResources:

  ClusterConfig:
    InstanceCount: 1
    InstanceType: ml.m5.xlarge
    VolumeSizeInGB: 50

StoppingCondition:
  MaxRuntimeInSeconds: 3600
